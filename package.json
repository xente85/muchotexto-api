{
  "type": "module",
  "name": "muchotexto-api",
  "version": "2.0.0",
  "private": true,
  "description": "API de MuchoTexto: extracción de artículos, resúmenes, traducciones y análisis de evidencias con IA.",
  "main": "src/server.js",
  "scripts": {
    "prestart": "node check-node-version.cjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js && npm test",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "nix": "nix-shell --run 'npm run start'"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xente85/article-extractor-api.git"
  },
  "license": "ISC",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "axios": "^1.13.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "jsdom": "^26.0.0"
  },
  "bugs": {
    "url": "https://github.com/xente85/article-extractor-api/issues"
  },
  "homepage": "https://github.com/xente85/article-extractor-api#readme"
}
