# --- Proveedor de IA ---
AI_PROVIDER=deepseek            # deepseek | kimi | openai
AI_MODEL=deepseek-v4-flash      # vacío = modelo por defecto del proveedor
AI_MAX_TOKENS=500
AI_TIMEOUT_MS=60000
AI_BASE_URL=                    # opcional: endpoint compatible con OpenAI (Ollama, LM Studio…)

DEEPSEEK_API_KEY=               # también se usa para la búsqueda web del análisis de evidencias
OPENAI_API_KEY=
MOONSHOT_API_KEY=

# --- Servidor ---
PORT=3000
HOST=127.0.0.1                  # docker-compose lo cambia a 0.0.0.0
DB_PATH=data/muchotexto.db

# --- Límites y cuotas (0 = sin límite) ---
RATE_LIMIT_PER_MINUTE=20        # por instalación
DAILY_QUOTA=200                 # resúmenes, traducciones y respuestas por instalación y día
FACT_CHECK_DAILY_QUOTA=20
FACT_CHECK_MAX_CONCURRENT=2
MAX_PROMPT_CHARS=40000
MAX_CHAT_MESSAGES=12            # mensajes recientes enviados al proveedor en una conversación
REQUIRE_INSTALL_ID=true

# --- Retención de datos ---
CHAT_TTL_DAYS=7
RESPONSE_CACHE_TTL_DAYS=7

# --- Artículos ---
ARTICLE_TIMEOUT_MS=10000
ARTICLE_CACHE_SIZE=200
ARTICLE_CACHE_TTL_MINUTES=60
ALLOW_PRIVATE_NETWORK=false     # true para permitir que el servidor lea URLs de tu red local
